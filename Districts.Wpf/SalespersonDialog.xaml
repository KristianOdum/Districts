<Window x:Class="Districts.Wpf.SalespersonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Salesperson"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="20">

        <TextBlock Text="Select salesperson"
                   Margin="0,0,0,5"/>

        <StackPanel>
            <TextBox x:Name="SalespersonSearchBox"
                     Width="250"
                     Height="30"
                     VerticalContentAlignment="Center"
                     TextChanged="SalespersonSearchBox_TextChanged"/>

            <ListBox x:Name="SalespersonListBox"
                     Width="250"
                     Height="100"
                     Margin="0,5,0,0"
                     DisplayMemberPath="Name"
                     SelectionChanged="SalespersonListBox_SelectionChanged"
                     MouseDoubleClick="SalespersonListBox_MouseDoubleClick"/>
        </StackPanel>

        <TextBlock Text="Role"
                   Margin="0,15,0,5"/>

        <ComboBox x:Name="RoleComboBox"
                  Width="250"
                  Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="70"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="OK"
                    Width="70"
                    Click="Ok_Click"/>

        </StackPanel>

    </StackPanel>
</Window>