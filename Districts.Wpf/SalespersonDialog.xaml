<Window x:Class="Districts.Wpf.SalespersonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Salesperson"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Width="250" Margin="20">

        <TextBlock Text="Select salesperson"
                   Margin="0,0,0,5" />

        <Grid Height="30">
            <TextBox x:Name="SalespersonSearchBox"

                     Padding="5,0"
                     VerticalContentAlignment="Center"
                     TextChanged="SalespersonSearchBox_TextChanged" />

            <TextBlock Text="Search..."
                       Foreground="Gray"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility"
                                Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding Text, ElementName=SalespersonSearchBox}"
                                Value="">

                                <Setter Property="Visibility"
                                        Value="Visible" />

                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <ListBox x:Name="SalespersonListBox"
                 Height="100"
                 Margin="0,5,0,0"
                 DisplayMemberPath="Name"
                 SelectionChanged="SalespersonListBox_SelectionChanged"
                 MouseDoubleClick="SalespersonListBox_MouseDoubleClick" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="70"
                    Margin="0,0,10,0"
                    Click="Cancel_Click" />

            <Button Content="OK"
                    Width="70"
                    Click="Ok_Click" />

        </StackPanel>

    </StackPanel>
</Window>